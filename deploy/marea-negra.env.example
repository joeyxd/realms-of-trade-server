# Copy to /etc/marea-negra.env (chmod 600). docs/DEPLOY.md
PORT=5173
HOST=127.0.0.1
# 0.0.0.0 to reach it directly by IP without Caddy (then open the port in the firewall)
MAX_PLAYERS=4
BOTS=3
# Signs the saved games: generate once with `openssl rand -hex 32` and never change it (or everyone starts over).
SAVE_SECRET=change-me
# Only pages from these origins may open the game socket (your domain); empty = any.
ORIGINS=
# Never 1 on a public server (F4 panel and teleports).
DEV=0
