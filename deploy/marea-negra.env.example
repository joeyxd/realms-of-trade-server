# Copy to /etc/marea-negra.env (chmod 600). docs/DEPLOY.md
PORT=5173
HOST=127.0.0.1
# 0.0.0.0 to reach it directly by IP without Caddy (then open the port in the firewall)
MAX_PLAYERS=4
BOTS=3
# One authority per world ID. Keep the ID stable across restarts; never run two processes on the same ID.
WORLD_ID=marea-negra
WORLD_SAVE_SECONDS=60
# Signs the saved games: generate once with `openssl rand -hex 32` and never change it (or everyone starts over).
SAVE_SECRET=change-me
# M5 adapter selection: this pair alone intentionally leaves accounts disabled.
# Set both server-only values together. A partial configuration fails startup.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=server-service-key
# Add a publishable key (sb_publishable_...) or legacy anon JWT to enable title login.
# Never put a secret/service_role key here: /auth/config exposes this value publicly.
# Apply migrations 001_store.sql then 002_accounts.sql before enabling accounts.
# SUPABASE_PUBLIC_KEY=sb_publishable_your-public-key
# Optional wallet linking, off by default. Requires accounts/durable Supabase above and optional
# Web3 migrations 002_wallet_link.sql then 003_wallet_readiness.sql (not game SQL 002/003).
# Origin is the exact HTTPS game-page origin; HTTP is allowed only on loopback for local development.
# Polygon PoS selected by the author: Amoy pilot 80002, future mainnet 137.
# Set the chain ID explicitly; no RPC provider is inferred. Test links/tokens do not migrate to mainnet.
MN_WEB3_WALLET_ENABLED=0
# MN_WEB3_WALLET_ORIGIN=https://game.example
# MN_WEB3_WALLET_CHAIN_ID=80002
# MN_WEB3_WALLET_TTL_MS=300000
# Operator preflight only: node tools/web3-wallet-preflight.mjs --check (env must be supplied explicitly).
# Explicit Amoy RPC endpoint from the operator's chosen provider. May contain a key; keep server-side.
# It does not enable RPC polling or token integration in npm start.
# MN_WEB3_RPC_URL=https://your-selected-amoy-rpc.example
# Standalone read-only ERC-721 tool: node tools/web3-token-read.mjs --read
# Requires the explicit chain/RPC above, one trusted contract and an expected block number/hash.
# It does not enable Web3 or assign game ownership. No contract/token/block default is inferred.
# MN_WEB3_READ_CONTRACT=
# MN_WEB3_READ_TOKEN_ID=0
# MN_WEB3_READ_BLOCK_NUMBER=
# MN_WEB3_READ_BLOCK_HASH=
# Standalone ERC-1155 balances: node tools/web3-edition-read.mjs --read
# Uses the explicit read inputs above plus a holder. Balance is an observation, not a game entitlement.
# MN_WEB3_READ_HOLDER=
# Only pages from these origins may open the game socket (your domain); empty = any.
ORIGINS=
# Never 1 on a public server (F4 panel and teleports).
DEV=0
